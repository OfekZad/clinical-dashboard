# Dashboard / browser Supabase config used by this Next.js app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Edge Function runtime for joy-voice.
# Do not expose this service-role key to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stored in Supabase Vault, not here:
# anthropic_api_key
# dial_signing_secret

# Optional dashboard submission used by the scheduled task only when
# $HOME/mnt/Agent Check in/dial/dashboard.env exists.
DASHBOARD_BASE_URL=
