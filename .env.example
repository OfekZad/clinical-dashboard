# Dashboard local development (public anon key only; no service-role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Edge Function runtime (set in Supabase, not committed with real values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dashboard submission. Leave blank when the dashboard bridge is not used.
DASHBOARD_BASE_URL=

# Stored in Supabase Vault through public.get_secret(secret_name text), not here:
# anthropic_api_key
# dial_signing_secret
